# Von der Havenmail Control-Plane gerendert — nicht manuell bearbeiten.
# Basis: Debian-Postfix-Standardkonfiguration, ergänzt um Havenmail-
# spezifische virtuelle Domains/Mailboxen/Aliase und restriktive
# Relay-/TLS-Defaults. Siehe docs/architecture.md (Sicherheitsmodell,
# Bedrohungsanalyse).

myhostname = {{ mail_hostname }}
smtpd_banner = $myhostname ESMTP

# --- Zustellung: nur eigene virtuelle Domains, kein Open Relay ---
virtual_mailbox_domains = pgsql:/etc/postfix/havenmail/pgsql-virtual-domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/havenmail/pgsql-virtual-mailboxes.cf
virtual_alias_maps = pgsql:/etc/postfix/havenmail/pgsql-virtual-aliases.cf
virtual_mailbox_base = /var/mail/havenmail
virtual_minimum_uid = 5000
virtual_uid_maps = static:5000
virtual_gid_maps = static:5000

# Zustellung läuft über Dovecots LMTP statt Postfix' eigenem virtual(8)-
# Agenten (dessen master.cf-"lmtp"-Client-Transport ist Debian-Standard,
# unverändert vorhanden) — nur so greift Dovecots Quota-Plugin
# (siehe config/dovecot/90-quota.conf.tera) tatsächlich, sonst landet
# Mail direkt im Maildir, ohne dass quota_bytes je geprüft wird.
# virtual_mailbox_limit/-uid_maps/-gid_maps oben bleiben harmlos stehen
# (virtual(8)-spezifisch, jetzt ungenutzt), keine Notwendigkeit sie zu
# entfernen. Live isoliert getestet: RCPT TO wird bei Überschreitung
# korrekt mit "552 5.2.2 Quota exceeded" abgelehnt.
virtual_transport = lmtp:unix:private/dovecot-lmtp

# reject_sender_login_mismatch auf submission/smtps (siehe
# master.cf.append) braucht diese Map, sonst gilt JEDE Absenderadresse
# als "nicht owned" und Versand wird für alle Benutzer abgelehnt.
smtpd_sender_login_maps = pgsql:/etc/postfix/havenmail/pgsql-sender-login-maps.cf

# mynetworks bewusst explizit NUR auf Loopback beschränkt — ohne diese
# Zeile fällt Postfix auf seinen einprogrammierten Default
# "mynetworks_style = subnet" zurück, der automatisch JEDEM Host im
# selben Subnetz Relay-Vertrauen (permit_mynetworks unten) einräumt. Auf
# einem Cloud-/VPS-Host mit geteiltem Subnetz wäre das ein Open Relay für
# fremde Hosts im selben Adressblock, trotz der unten dokumentierten
# Restriktivitäts-Absicht (gefunden im Sicherheits-/Bug-Audit vom
# 2026-08-07). Echter Mailversand läuft ausschließlich über SASL-Auth auf
# Submission/SMTPS (permit_sasl_authenticated unten) — mynetworks deckt
# hier nur noch den lokalen Postfix-Prozess selbst ab (z. B.
# /usr/sbin/sendmail-Aufrufe für Benachrichtigungs-E-Mails und
# Sieve-Autoresponder, die beide über die lokale pickup-Queue laufen,
# nicht über smtpd — brauchen mynetworks daher eigentlich gar nicht,
# schadet als zusätzliche Absicherung aber nicht).
mynetworks = 127.0.0.0/8 [::1]/128

# Eingehend (Port 25): kein Relay für fremde Domains, keine unauthentifizierte
# Weiterleitung. sender/recipient-Restriktionen bewusst restriktiv, nicht
# nur "permit_mynetworks".
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_pipelining,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    reject_unauth_destination

# Rspamd wird bereits per Milter angebunden (smtpd_milters/
# non_smtpd_milters unten, inet:127.0.0.1:11332) - das deckt
# Spam-/DKIM-/DMARC-Bewertung vollständig ab. Ein zusätzliches
# "check_policy_service unix:private/rspamd-policy" in
# smtpd_recipient_restrictions stand hier zusätzlich, obwohl kein
# Rspamd-Worker in dieser Konfiguration einen Unix-Socket dieses Namens
# je erstellt - jede eingehende Mail wurde dadurch mit "451 4.3.5
# Server configuration problem" abgelehnt (Policy-Socket nicht
# erreichbar). Ohne Ersatz entfernt, da der Milter-Pfad bereits genügt.

# --- SASL-Authentifizierung über Dovecot ---
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $myhostname

# --- TLS (Submission/SMTPS erzwungen, eingehend angeboten) ---
smtpd_tls_cert_file = {{ tls_cert_path }}
smtpd_tls_key_file = {{ tls_key_path }}
smtpd_tls_security_level = may
smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtp_tls_security_level = may
smtp_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1

# --- Limits ---
message_size_limit = 52428800
mailbox_size_limit = 0
# virtual_mailbox_limit ist trotz ähnlichen Namens ein vom virtual(8)-
# Delivery-Agent genutzter, von mailbox_size_limit unabhängiger
# Parameter (postfix-eigene Falle). Default (51200000) liegt unter
# message_size_limit (52428800) -> "fatal: configuration error:
# virtual_mailbox_limit is smaller than message_size_limit", der
# virtual-Agent crashlooped und JEDE lokale Zustellung bleibt in der
# Queue hängen. 0 = unlimitiert, passend zu mailbox_size_limit oben.
virtual_mailbox_limit = 0
smtpd_client_connection_rate_limit = 30
anvil_rate_time_unit = 60s

# --- Milter-Anbindung Rspamd (Spam/DKIM/DMARC-Auswertung) ---
milter_protocol = 6
milter_default_action = accept
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = inet:127.0.0.1:11332

compatibility_level = 3.6
