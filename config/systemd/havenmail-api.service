[Unit]
Description=Havenmail Control-Plane API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=havenmail
Group=havenmail
EnvironmentFile=/etc/havenmail/havenmail.env
ExecStart=/opt/havenmail/backend/target/release/havenmail-api
Restart=on-failure
RestartSec=2

# Hardening — siehe docs/architecture.md, Sicherheitsmodell.
# /etc/rspamd/local.d ist eine bewusste, dokumentierte Lockerung: die
# Sicherheits-Einstellungsseiten im Admin-Panel (Spam-/Virenschutz) müssen
# echte Rspamd-Konfigurationsdateien schreiben können, siehe
# routes/security_settings.rs. Jede Änderung wird vor dem Anwenden per
# `rspamadm configtest` verifiziert.
# /var/mail/havenmail ebenso bewusst gelockert: die Abwesenheitsnotiz
# (routes/vacation.rs) schreibt das `.dovecot.sieve`-Skript direkt ins
# Mailbox-Home des jeweiligen Postfachs und kompiliert es per `sievec`
# (Sicherheitsnetz: Compile-Fehler verwirft die Änderung, siehe dortiger
# Kommentar). Derselbe Systembenutzer (uid 5000) besitzt diese
# Verzeichnisse bereits regulär (siehe scripts/lib/common.sh), die
# Lockerung hier ist rein die ProtectSystem=strict-Bind-Mount-Ebene.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/havenmail /var/log/havenmail /etc/rspamd/local.d /var/mail/havenmail
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# MemoryDenyWriteExecute bewusst NICHT gesetzt: `rspamadm configtest` wird
# als Kindprozess dieses Diensts aufgerufen (Sicherheitsnetz vor jeder
# Rspamd-Config-Änderung, siehe routes/security_settings.rs) und braucht
# dafür seine LuaJIT-Engine, die zur Laufzeit ausführbaren Code erzeugt
# (W^X-Verletzung) — mit dieser Einstellung stürzt rspamadm mit "PANIC:
# unprotected error in call to Lua API (runtime code generation failed,
# restricted kernel?)" ab. Live isoliert verifiziert: exakt dieses eine
# Flag verursacht den Absturz, alle übrigen Härtungsmaßnahmen unten bleiben
# unverändert wirksam.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
