# Havenmail — Beispielkonfiguration
# Diese Datei enthält KEINE echten Geheimnisse. Kopiere sie nach `.env` und
# fülle die Werte aus bzw. lasse sie vom Installer generieren.

# --- Allgemein ---
HAVENMAIL_DOMAIN=example.org
HAVENMAIL_HOSTNAME=mail.example.org
HAVENMAIL_ADMIN_EMAIL=admin@example.org
HAVENMAIL_TIMEZONE=Europe/Berlin

# --- Datenbank ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=havenmail
POSTGRES_USER=havenmail
# POSTGRES_PASSWORD wird vom Installer zufällig generiert und NICHT hier abgelegt.
# DATABASE_URL wird vom Installer aus den POSTGRES_*-Werten und dem generierten
# Passwort zusammengesetzt (Format: postgres://USER:PASSWORT@HOST:PORT/DB) und
# von der Control-Plane (backend/crates/api) beim Start gelesen.
# DATABASE_URL=postgres://havenmail:CHANGE_ME@127.0.0.1:5432/havenmail

# --- Control-Plane ---
HAVENMAIL_API_BIND=127.0.0.1:8080
HAVENMAIL_API_PUBLIC_URL=https://mail.example.org
# HAVENMAIL_JWT_SIGNING_KEY wird vom Installer zufällig generiert (mind. 32 Byte).
# HAVENMAIL_SECRETS_KEY wird vom Installer zufällig generiert (genau 32 Byte) —
# verschlüsselt DKIM-Privatschlüssel (AES-256-GCM) in der Datenbank.

# --- TLS/ACME ---
ACME_EMAIL=admin@example.org
ACME_PROVIDER=letsencrypt

# --- Backup (siehe docs/backup-restore.md; von backup.sh/restore.sh/update.sh gelesen) ---
# HAVENMAIL_BACKUP_DIR=/var/backups/havenmail
# HAVENMAIL_BACKUP_RETENTION=14
# HAVENMAIL_BACKUP_PASSPHRASE=   # gesetzt lassen -> Backups werden gpg-verschlüsselt
BACKUP_TARGET=local
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# --- Installer-Quelle (nur für den Single-File-curl-Bootstrap relevant,
# siehe docs/installation.md) ---
# HAVENMAIL_SOURCE_REPO=https://github.com/USERNAME/havenmail.git
