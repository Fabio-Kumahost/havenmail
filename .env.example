# Havenmail — Beispielkonfiguration
# Diese Datei enthält KEINE echten Geheimnisse. Kopiere sie nach `.env` und
# fülle die Werte aus bzw. lasse sie vom Installer generieren.

# --- Allgemein ---
HAVENMAIL_DOMAIN=example.org
HAVENMAIL_HOSTNAME=mail.example.org
HAVENMAIL_ADMIN_EMAIL=admin@example.org
HAVENMAIL_TIMEZONE=Europe/Berlin

# --- Datenbank ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=havenmail
POSTGRES_USER=havenmail
# POSTGRES_PASSWORD wird vom Installer zufällig generiert und NICHT hier abgelegt.

# --- Control-Plane ---
HAVENMAIL_API_BIND=127.0.0.1:8080
HAVENMAIL_API_PUBLIC_URL=https://mail.example.org
# HAVENMAIL_JWT_SIGNING_KEY wird vom Installer zufällig generiert.

# --- TLS/ACME ---
ACME_EMAIL=admin@example.org
ACME_PROVIDER=letsencrypt

# --- Backup (optional S3-kompatibel) ---
BACKUP_TARGET=local
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
